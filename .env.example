PORT=3000
DATABASE_URL="postgresql://myuser:mysecretpassword@localhost/janoluck?sslmode=disable"
REDIS_ADDR=
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=janoluck
KAFKA_CONSUMER_GROUP=janoluck-email-worker
KAFKA_SESSION_CONSUMER_GROUP=janoluck-session-worker
RESEND_API_KEY=
LLM_API_KEY=openrouter_api_key
LLM_MODEL_NAME=
REDIS_PASSWORD=
REDIS_DB=
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# rate limiting
# Set TRUST_PROXY=true only when a reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
