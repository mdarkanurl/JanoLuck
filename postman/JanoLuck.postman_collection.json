{
  "info": {
    "_postman_id": "d9f1c4a2-7f3b-4b8a-9c2e-1a6d5e8f0b21",
    "name": "JanoLuck API",
    "description": "Simple collection for every route exposed by the JanoLuck Go server.\n\nOnly one environment variable is used: `bash_url`.\n\nEmail and password are hardcoded. After Login or Verify email, copy the access token into the collection Authorization setting (currently `PASTE_ACCESS_TOKEN_HERE`). Replace `PASTE_SESSION_ID_HERE` in the session/chat URLs with a real session UUID.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "PASTE_ACCESS_TOKEN_HERE",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bash_url}}/health",
              "host": [
                "{{bash_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "GET /health\n\nReturns plain text: OK!"
          },
          "response": []
        }
      ]
